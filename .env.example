# Copy this file to .env.local and fill in the two values.
# Do not commit .env.local.

# The "Web app" URL you get after deploying apps-script/Code.gs (ends in /exec)
VITE_APPS_SCRIPT_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec
# Must exactly match the TOKEN value inside Code.gs
VITE_API_TOKEN=replace-with-your-secret
